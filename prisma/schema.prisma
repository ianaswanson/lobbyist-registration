generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appeal {
  id             String       @id
  violationId    String
  submittedDate  DateTime     @default(now())
  appealDeadline DateTime
  reason         String
  status         AppealStatus @default(PENDING)
  hearingDate    DateTime?
  decision       String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Violation      Violation    @relation(fields: [violationId], references: [id], onDelete: Cascade)

  @@index([hearingDate])
  @@index([status])
  @@index([violationId])
}

model AuditLog {
  id          String   @id
  userId      String
  action      String
  entityType  String
  entityId    String?
  changesJson String?
  ipAddress   String?
  timestamp   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
}

model BoardCalendarEntry {
  id               String      @id
  boardMemberId    String
  eventTitle       String
  eventDate        DateTime
  eventTime        String?
  participantsList String
  quarter          Quarter
  year             Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  BoardMember      BoardMember @relation(fields: [boardMemberId], references: [id], onDelete: Cascade)

  @@index([boardMemberId])
  @@index([eventDate])
  @@index([quarter, year])
}

model BoardLobbyingReceipt {
  id            String      @id
  boardMemberId String
  lobbyistId    String
  amount        Float
  date          DateTime
  payee         String
  purpose       String
  quarter       Quarter
  year          Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  BoardMember   BoardMember @relation(fields: [boardMemberId], references: [id], onDelete: Cascade)
  Lobbyist      Lobbyist    @relation(fields: [lobbyistId], references: [id], onDelete: Cascade)

  @@index([boardMemberId])
  @@index([lobbyistId])
  @@index([quarter, year])
}

model BoardMember {
  id                   String                 @id
  userId               String                 @unique
  name                 String
  district             String?
  termStart            DateTime
  termEnd              DateTime?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  BoardCalendarEntry   BoardCalendarEntry[]
  BoardLobbyingReceipt BoardLobbyingReceipt[]
  User                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model ComplianceAlert {
  id                   String        @id
  type                 AlertType
  severity             AlertSeverity
  message              String
  relatedReportId      String?
  relatedUserId        String?
  reviewedAt           DateTime?
  reviewedBy           String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime
  resultingViolationId String?

  @@index([createdAt])
  @@index([resultingViolationId])
  @@index([reviewedAt])
  @@index([severity])
  @@index([type])
}

model ContractException {
  id                  String    @id
  formerOfficialId    String
  formerOfficialName  String
  contractDescription String
  justification       String
  approvedBy          String
  approvedDate        DateTime
  publiclyPostedDate  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime

  @@index([approvedDate])
  @@index([formerOfficialId])
}

model Employer {
  id                    String                  @id
  userId                String?                 @unique
  name                  String
  email                 String
  phone                 String
  address               String
  businessDescription   String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  User                  User?                   @relation(fields: [userId], references: [id])
  EmployerExpenseReport EmployerExpenseReport[]
  LobbyistEmployer      LobbyistEmployer[]

  @@index([email])
  @@index([name])
}

model EmployerExpenseReport {
  id                          String                    @id
  employerId                  String
  quarter                     Quarter
  year                        Int
  totalLobbyingSpend          Float                     @default(0)
  status                      ReportStatus              @default(DRAFT)
  submittedAt                 DateTime?
  dueDate                     DateTime
  reviewedBy                  String?
  reviewedAt                  DateTime?
  reviewNotes                 String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime
  amendmentReason             String?
  originalReportId            String?
  amendedByReportId           String?
  Employer                    Employer                  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  EmployerExpenseReport       EmployerExpenseReport?    @relation("EmployerExpenseReportToEmployerExpenseReport", fields: [originalReportId], references: [id], onDelete: Restrict)
  other_EmployerExpenseReport EmployerExpenseReport[]   @relation("EmployerExpenseReportToEmployerExpenseReport")
  EmployerLobbyistPayment     EmployerLobbyistPayment[]

  @@index([amendedByReportId])
  @@index([dueDate])
  @@index([employerId, year])
  @@index([originalReportId])
  @@index([status])
}

model EmployerLobbyistPayment {
  id                    String                @id
  employerReportId      String
  lobbyistId            String
  amountPaid            Float
  createdAt             DateTime              @default(now())
  updatedAt             DateTime
  EmployerExpenseReport EmployerExpenseReport @relation(fields: [employerReportId], references: [id], onDelete: Cascade)
  Lobbyist              Lobbyist              @relation(fields: [lobbyistId], references: [id], onDelete: Cascade)

  @@unique([employerReportId, lobbyistId])
  @@index([employerReportId])
  @@index([lobbyistId])
}

model ExpenseLineItem {
  id           String            @id
  reportId     String
  reportType   ExpenseReportType
  officialName String
  date         DateTime
  payee        String
  purpose      String
  amount       Float
  isEstimate   Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime

  @@index([date])
  @@index([officialName])
  @@index([reportId])
}

model HourLog {
  id           String   @id
  lobbyistId   String
  activityDate DateTime
  hours        Float
  description  String
  quarter      Quarter
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Lobbyist     Lobbyist @relation(fields: [lobbyistId], references: [id], onDelete: Cascade)

  @@index([activityDate])
  @@index([lobbyistId])
  @@index([quarter, year])
}

model Lobbyist {
  id                      String                    @id
  userId                  String                    @unique
  name                    String
  email                   String
  phone                   String
  address                 String
  registrationDate        DateTime                  @default(now())
  status                  RegistrationStatus        @default(DRAFT)
  hoursCurrentQuarter     Float                     @default(0)
  thresholdExceededDate   DateTime?
  registrationDeadline    DateTime?
  reviewedBy              String?
  reviewedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  BoardLobbyingReceipt    BoardLobbyingReceipt[]
  EmployerLobbyistPayment EmployerLobbyistPayment[]
  HourLog                 HourLog[]
  User                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  LobbyistEmployer        LobbyistEmployer[]
  LobbyistExpenseReport   LobbyistExpenseReport[]

  @@index([email])
  @@index([registrationDate])
  @@index([status])
}

model LobbyistEmployer {
  id                       String    @id
  lobbyistId               String
  employerId               String
  authorizationDocumentUrl String?
  authorizationDate        DateTime?
  startDate                DateTime  @default(now())
  endDate                  DateTime?
  subjectsOfInterest       String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  Employer                 Employer  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  Lobbyist                 Lobbyist  @relation(fields: [lobbyistId], references: [id], onDelete: Cascade)

  @@unique([lobbyistId, employerId, startDate])
  @@index([employerId])
  @@index([lobbyistId])
}

model LobbyistExpenseReport {
  id                          String                  @id
  lobbyistId                  String
  quarter                     Quarter
  year                        Int
  totalFoodEntertainment      Float                   @default(0)
  status                      ReportStatus            @default(DRAFT)
  submittedAt                 DateTime?
  dueDate                     DateTime
  reviewedBy                  String?
  reviewedAt                  DateTime?
  reviewNotes                 String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime
  amendmentReason             String?
  originalReportId            String?
  amendedByReportId           String?
  Lobbyist                    Lobbyist                @relation(fields: [lobbyistId], references: [id], onDelete: Cascade)
  LobbyistExpenseReport       LobbyistExpenseReport?  @relation("LobbyistExpenseReportToLobbyistExpenseReport", fields: [originalReportId], references: [id], onDelete: Restrict)
  other_LobbyistExpenseReport LobbyistExpenseReport[] @relation("LobbyistExpenseReportToLobbyistExpenseReport")

  @@index([amendedByReportId])
  @@index([dueDate])
  @@index([lobbyistId, year])
  @@index([originalReportId])
  @@index([status])
}

model User {
  id                                      String         @id
  email                                   String         @unique
  name                                    String
  role                                    UserRole       @default(PUBLIC)
  password                                String
  status                                  UserStatus     @default(ACTIVE)
  passwordResetRequired                   Boolean        @default(false)
  lastLoginAt                             DateTime?
  createdAt                               DateTime       @default(now())
  updatedAt                               DateTime
  AuditLog                                AuditLog[]
  BoardMember                             BoardMember?
  Employer                                Employer?
  Lobbyist                                Lobbyist?
  UserAuditLog_UserAuditLog_adminIdToUser UserAuditLog[] @relation("UserAuditLog_adminIdToUser")
  UserAuditLog_UserAuditLog_userIdToUser  UserAuditLog[] @relation("UserAuditLog_userIdToUser")

  @@index([email])
  @@index([role])
  @@index([status])
}

model UserAuditLog {
  id                              String   @id
  userId                          String
  adminId                         String
  action                          String
  changes                         Json?
  ipAddress                       String?
  createdAt                       DateTime @default(now())
  User_UserAuditLog_adminIdToUser User     @relation("UserAuditLog_adminIdToUser", fields: [adminId], references: [id], onDelete: Cascade)
  User_UserAuditLog_userIdToUser  User     @relation("UserAuditLog_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@index([userId])
}

model Violation {
  id                   String          @id
  entityType           EntityType
  entityId             String
  violationType        ViolationType
  description          String
  fineAmount           Float           @default(0)
  status               ViolationStatus @default(PENDING)
  issuedDate           DateTime?
  isFirstTimeViolation Boolean         @default(false)
  resolutionNotes      String?
  resolutionDate       DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime
  sourceAlertId        String?
  Appeal               Appeal[]

  @@index([entityType, entityId])
  @@index([issuedDate])
  @@index([sourceAlertId])
  @@index([status])
}

enum AlertSeverity {
  HIGH
  MEDIUM
  LOW
}

enum AlertType {
  UNUSUAL_SPENDING
  DUPLICATE_ENTRY
  OVERDUE_REPORT
  MISSING_FIELDS
  ROUND_NUMBER_PATTERN
  FIRST_TIME_FILER
}

enum AppealStatus {
  PENDING
  SCHEDULED
  DECIDED
}

enum EntityType {
  LOBBYIST
  EMPLOYER
  LOBBYIST_REPORT
  EMPLOYER_REPORT
  BOARD_MEMBER
}

enum ExpenseReportType {
  LOBBYIST
  EMPLOYER
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

enum RegistrationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  LATE
  OVERDUE
  APPROVED
  REJECTED
  NEEDS_CLARIFICATION
  AMENDED
}

enum UserRole {
  PUBLIC
  LOBBYIST
  EMPLOYER
  BOARD_MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ViolationStatus {
  PENDING
  ISSUED
  APPEALED
  UPHELD
  OVERTURNED
  PAID
  WAIVED
}

enum ViolationType {
  LATE_REGISTRATION
  LATE_REPORT
  MISSING_REPORT
  FALSE_STATEMENT
  PROHIBITED_CONDUCT
  MISSING_AUTHORIZATION
  OTHER
}
